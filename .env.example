# Server Configuration
PORT=3000
NODE_ENV="development"

# JWT Secret for Auth Token generation & verification
JWT_SECRET="taskflow_jwt_super_secret_production_key_change_in_prod_123456"

# Database Connection
# Provide a MongoDB connection string (e.g. MongoDB Atlas or local mongod)
# If left empty or unreachable, TaskFlow seamlessly activates its embedded persistent document store
MONGODB_URI=""

# Client Origin (for CORS in split deployments)
CLIENT_ORIGIN="http://localhost:3000"

# GEMINI_API_KEY: Optional, injected automatically if using AI Studio capabilities
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"
